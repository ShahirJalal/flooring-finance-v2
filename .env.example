# Copy this file to .env and adjust values. .env is gitignored - never commit real secrets.

# --- PostgreSQL ---
POSTGRES_DB=flooring_finance
POSTGRES_USER=finance
POSTGRES_PASSWORD=change-me-please

# --- Backend / Spring Boot ---
# "dev" enables the realistic development seed data (see backend/.../seed/DataSeeder.java).
# Use "prod" once real jobs are being entered - it disables seeding.
SPRING_PROFILES_ACTIVE=dev

# Long, random secret used to sign JWTs. Generate one with e.g.:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-value
JWT_EXPIRATION_MS=604800000

# Origin(s) allowed to call the API (comma-separated, no trailing slash).
APP_CORS_ALLOWED_ORIGINS=http://localhost

# Set to true once served over HTTPS (e.g. behind the Cloudflare Tunnel in production).
# Must stay false for plain http://localhost local development.
COOKIE_SECURE=false

# --- Ports (change if these clash with something else on the host) ---
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=80
